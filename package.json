{
  "name": "bro-battles",
  "version": "1.0.0",
  "description": "Real-time multiplayer browser battle arena (Phaser, Express, Socket.IO).",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --watch src/server --watch src/shared --ext js,json --exec node src/server/server.js",
    "build": "webpack --mode production",
    "cleanbuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "sourcemap": "cross-env NODE_ENV=production webpack --mode=production --devtool=source-map",
    "start": "cross-env NODE_ENV=production node src/server/server.js",
    "test:shop": "node --test \"tests/{shop*,stripeWebhook}.test.{js,cjs,mjs}\"",
    "test:bots": "node --test \"tests/{bot*,adaptiveBots,gameRoomStartup,navigationService}.test.{js,cjs,mjs}\"",
    "test:battle-log": "node --test tests/battleLog.test.js",
    "test:network": "node --test \"tests/{net*,*Network*,movementCorrection,serverClockAndHistory,ninjaCombat,ninjaRenderer,sparrowCombat,sparrowRenderer,attackDelivery}.test.{js,cjs,mjs}\"",
    "test:slow": "node --test \"tests/slow/**/*.test.{js,cjs,mjs}\"",
    "simulate:bots": "node scripts/dev/simulate-bots.cjs",
    "net:probe": "node scripts/dev/net-probe.mjs",
    "net:report": "node scripts/dev/net-report.mjs",
    "test": "node --test \"tests/*.test.{js,cjs,mjs}\"",
    "test:all": "node --test \"tests/*.test.{js,cjs,mjs}\" \"tests/slow/**/*.test.{js,cjs,mjs}\"",
    "lint": "eslint .",
    "validate:content": "node scripts/dev/validate-content.cjs",
    "migrate:status": "node scripts/db/migration-status.cjs",
    "migrate:apply": "node scripts/db/apply-migration.cjs",
    "test:db": "node tests/siteSupport.integration.cjs && node scripts/db/verify-email-db.cjs && node scripts/db/verify-trophy-road.cjs",
    "test:trophies": "node --test tests/trophyProgression.test.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.6",
    "cookie-signature": "^1.0.6",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "markdown-it": "^14.3.2",
    "mysql2": "^3.14.3",
    "phaser": "^3.70.0",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.8",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "linkedom": "0.18.12",
    "mini-css-extract-plugin": "^2.9.4",
    "nodemon": "^3.0.2",
    "playwright-core": "^1.64.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-middleware": "^7.0.0",
    "webpack-hot-middleware": "^2.26.0"
  }
}

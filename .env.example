NODE_ENV=development
PORT=3002
SECURE_COOKIES=false
COOKIE_SECRET=
ADMIN_USERS=nishay

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=game
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100

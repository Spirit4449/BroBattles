NODE_ENV=development
PORT=3002
SECURE_COOKIES=false
COOKIE_SECRET=
ADMIN_USERS=nishay

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=game
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100
DB_ACQUIRE_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000

# Comma-separated proxy IPs/CIDRs only when deployed behind a trusted proxy.
TRUST_PROXY=
# Use a persistent directory when deploying in a container.
# MATCH_RESULT_DIR=/var/lib/bro-battles/match-results

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:3002
STRIPE_AUTOMATIC_TAX=false

# Optional: enables AI-assisted Help Center search. Keep this server-side.
GEMINI_API_KEY=

# Resend (EMAIL_API_KEY is also supported). Never expose in client bundles.
RESEND_API_KEY=
EMAIL_FROM=Bro Battles <noreply@classchats.net>
# Destination inbox for new feedback/help alerts. Required to enable delivery.
EMAIL_NOTIFICATIONS_TO=
# Optional dedicated HMAC secret; defaults to COOKIE_SECRET.
EMAIL_VERIFICATION_SECRET=

# Marketing is opt-in and cannot send until this valid postal footer is set.
MARKETING_POSTAL_ADDRESS=
# A Resend API key with Contacts access. It syncs in-game marketing preferences
# to the Resend Broadcast audience; it is separate from the send-only key.
RESEND_MARKETING_API_KEY=
